---
import HubIntelligence from "./HubIntelligence.astro";
import TopIssues from "./TopIssues.astro";
import { site } from "../data/site";
import Base from "../layouts/Base.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import { insights } from "../data/insights";
const topics = [
  {
    id: "ai",
    name: "AI security",
    icon: "✧",
    summary: "Understand the risks. Set boundaries for your AI.",
    start: "Inventory the AI tools, models, and agents your team uses.",
    link: "/blog/top-10-ai-security-risks-2026.html",
    label: "Explore AI risks",
  },
  {
    id: "cloud",
    name: "Cloud security",
    icon: "☁",
    summary: "Find exposure. Protect identities and sensitive data.",
    start: "Review internet-facing assets and privileged cloud access.",
    link: "/blog/top-10-cspm-issues",
    label: "Explore cloud posture",
  },
  {
    id: "compliance",
    name: "Compliance",
    icon: "✓",
    summary: "Connect requirements to everyday evidence.",
    start: "Define your scope, owners, and the evidence you need to keep.",
    link: "#compliance",
    label: "Understand the frameworks",
  },
];
const guides = insights.filter((p) => p.local);
const collection = {"@context":"https://schema.org","@type":"CollectionPage",name:"Truva Security Hub",url:"https://truvasolutions.com/security-hub",isPartOf:{"@id":"https://truvasolutions.com/#website"},hasPart:guides.map(g=>({"@type":"WebPage",name:g.title,url:new URL(g.url,site.url).href}))};
---

<Base
  canonicalPath="/security-hub"
  title="Security Hub | AI, Cloud & Compliance | Truva Solutions"
  description="Explore Truva Solutions’ practical AI security, cloud security and compliance guides, visual checklists, and trusted primary sources."
>
  <script type="application/ld+json" set:html={JSON.stringify(collection).replace(/</g,"\\u003c")} />
  <SiteHeader showBooking={false} pageTitle="Security Hub" />
  <main id="main" class="hub shell">
    <div class="hub-layout">
      <aside class="hub-sidebar">
        <p class="eyebrow">YOUR SECURITY LIBRARY</p>
        <nav aria-label="Security Hub">
          <a href="#top-issues-title">Top issues</a>
          <a href="#priority-signals">Priority signals</a>
          <a href="#source-health">Source health</a>
          <a href="#ai-security">AI security</a>
          <a href="#cloud-tools">Cloud posture</a>
          <a href="#compliance">Compliance actions</a>
          <a href="#library">Guides</a>
        </nav>
        <div class="sidebar-note">
          <img src="/images/truva-mark.webp" width="25" height="28" alt="" />
          <strong>Truva Solutions</strong>
          <p>People. Product. Process.</p>
        </div>
      </aside>
      <div class="hub-content">
        <TopIssues />
        <HubIntelligence />
        <section id="overview" aria-labelledby="topics-title">
          <div class="section-label">
            <h2 id="topics-title">Explore your focus area</h2>
            <span>Three disciplines. One place.</span>
          </div>
          <div class="topic-grid">
            {topics.map((t) => (
              <a class="topic-card" href={t.link}>
                <span class="topic-icon" aria-hidden="true">
                  {t.icon}
                </span>
                <h3>{t.name}</h3>
                <p>{t.summary}</p>
                <span class="card-link">{t.label} →</span>
              </a>
            ))}
          </div>
        </section>
        <section class="start-panel" aria-labelledby="start-title">
          <div>
            <p class="eyebrow">START SMALL. MAKE PROGRESS.</p>
            <h2 id="start-title">Your first three checks</h2>
            <p>A starting point for a conversation—not a security score.</p>
          </div>
          <div class="checks">
            {topics.map((t) => (
              <label>
                <input type="checkbox" data-check={t.id} />
                <span>{t.start}</span>
              </label>
            ))}
            <p id="check-progress" role="status">
              Mark the checks you have reviewed.
            </p>
          </div>
        </section>
        <section id="library" aria-labelledby="library-title">
          <div class="section-label">
            <h2 id="library-title">Guides & infographics</h2>
            <a href="/security-hub/guides">Browse all guides →</a>
          </div>
          <div class="library-tools" hidden>
            <div
              class="filters"
              role="group"
              aria-label="Filter guides by topic"
            >
              <button type="button" data-filter="all" aria-pressed="true">
                All topics
              </button>
              <button type="button" data-filter="ai" aria-pressed="false">
                AI security
              </button>
              <button type="button" data-filter="cloud" aria-pressed="false">
                Cloud security
              </button>
              <button
                type="button"
                data-filter="compliance"
                aria-pressed="false"
              >
                Compliance
              </button>
            </div>
            <label class="search-label">
              <span class="sr-only">Search guides</span>
              <input
                type="search"
                id="hub-search"
                placeholder="Search guides…"
              />
            </label>
          </div>
          <p id="search-status" class="search-status" role="status"></p>
          <div class="guide-grid">
            {guides.map((p) => (
              <article
                class="guide-card"
                data-topic={p.category === "CLOUD SECURITY" ? "cloud" : "ai"}
                data-search={p.title + " " + p.description + " " + p.category}
              >
                <a href={p.url}>
                  <div class="guide-art">
                    <img
                      src={"/infographics/" + p.infographic + ".webp"}
                      width="1122"
                      height="1402"
                      alt={p.title + " — numbered infographic"}
                      loading="lazy"
                    />
                  </div>
                  <div class="guide-copy">
                    <span class="eyebrow">{p.category} · VISUAL GUIDE</span>
                    <h3>{p.title}</h3>
                    <p>{p.description}</p>
                    <span class="card-link">Read the guide →</span>
                  </div>
                </a>
              </article>
            ))}
            <article
              class="guide-card compact-guide"
              data-topic="compliance"
              data-search="compliance SOC 2 ISO 27001 ISO 42001 frameworks evidence audit"
            >
              <a href="#compliance">
                <span class="eyebrow">COMPLIANCE · QUICK EXPLAINER</span>
                <h3>SOC 2, ISO 27001 or ISO 42001?</h3>
                <p>
                  Understand what each covers before choosing your readiness
                  path.
                </p>
                <span class="framework-tags">
                  SOC 2 · ISO 27001 · ISO 42001
                </span>
                <span class="card-link">Compare the frameworks ↓</span>
              </a>
            </article>
          </div>
          <p id="no-results" hidden>
            No guides match. Try “cloud”, “LLM”, or “SOC 2”.
          </p>
        </section>
        <section
          id="compliance"
          class="compliance-panel"
          aria-labelledby="compliance-title"
        >
          <div class="section-label">
            <h2 id="compliance-title">Compliance, without the confusion.</h2>
          </div>
          <p>
            Start with customer needs and your business scope. These frameworks
            serve different purposes.
          </p>
          <div class="framework-grid">
            <article>
              <span class="eyebrow">CUSTOMER ASSURANCE</span>
              <h3>SOC 2</h3>
              <p>
                An independent CPA examination of controls relevant to the
                selected Trust Services Criteria. It produces a report, not an
                ISO certification.
              </p>
              <a href="https://www.aicpa-cima.com/resources/landing/system-and-organization-controls-soc-suite-of-services">
                Read AICPA’s overview ↗
              </a>
            </article>
            <article>
              <span class="eyebrow">INFORMATION SECURITY</span>
              <h3>ISO 27001</h3>
              <p>
                Requirements for an information security management system: how
                you manage risks, responsibilities, and continual improvement.
              </p>
              <a href="https://www.iso.org/standard/27001">
                Read ISO’s overview ↗
              </a>
            </article>
            <article>
              <span class="eyebrow">AI GOVERNANCE</span>
              <h3>ISO 42001</h3>
              <p>
                Requirements for an AI management system, helping organizations
                establish governance around developing or using AI.
              </p>
              <a href="https://www.iso.org/standard/42001">
                Read ISO’s overview ↗
              </a>
            </article>
          </div>
          <a class="card-link" href="/services#compliance">
            Explore Truva’s compliance services →
          </a>
        </section>
        <section id="trusted" aria-labelledby="trusted-title">
          <div class="section-label">
            <h2 id="trusted-title">Go deeper with primary sources</h2>
            <span>Selected by Truva Solutions</span>
          </div>
          <div class="source-grid">
            <a href="https://genai.owasp.org/llm-top-10/">
              <strong>OWASP LLM Top 10 ↗</strong>
              <span>Application risks and mitigation guidance</span>
            </a>
            <a href="https://www.nist.gov/itl/ai-risk-management-framework">
              <strong>NIST AI RMF ↗</strong>
              <span>A framework for managing AI risk</span>
            </a>
            <a href="https://www.cisecurity.org/cis-benchmarks">
              <strong>CIS Benchmarks ↗</strong>
              <span>Configuration guidance for your technology</span>
            </a>
          </div>
        </section>
        <section class="share-panel">
          <div>
            <h2>Useful enough to share.</h2>
            <p>
              Share a guide with your team or link to the Security Hub.
              Infographic downloads carry the Truva Solutions logo and source
              address.
            </p>
            <small>
              © 2026 Truva Solutions. Third-party sources retain their rights.
              The OWASP-based LLM adaptation is shared under CC BY-SA 4.0.
            </small>
          </div>
          <a
            class="button practitioner-link"
            href={site.bookingUrl || "/#consult"}
          >
            Talk to a security practitioner
          </a>
          <button class="button" id="copy-hub" hidden>
            Copy hub link
          </button>
          <p id="copy-status" role="status"></p>
        </section>
      </div>
    </div>
  </main>
  <SiteFooter />
</Base>
<script>
  const tools = document.querySelector<HTMLElement>(".library-tools")!;
  tools.hidden = false;
  const cards = [...document.querySelectorAll<HTMLElement>("[data-topic]")];
  const search = document.querySelector<HTMLInputElement>("#hub-search")!;
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-filter]"),
  ];
  let selected = "all";
  function filter() {
    let count = 0;
    for (const card of cards) {
      const show =
        (selected === "all" || card.dataset.topic === selected) &&
        card.dataset
          .search!.toLowerCase()
          .includes(search.value.trim().toLowerCase());
      card.hidden = !show;
      if (show) count++;
    }
    document.querySelector("#search-status")!.textContent = count + " guides";
    (document.querySelector("#no-results") as HTMLElement).hidden = count > 0;
  }
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      selected = b.dataset.filter!;
      buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      filter();
    }),
  );
  search.addEventListener("input", filter);
  filter();
  const checks = [
    ...document.querySelectorAll<HTMLInputElement>("[data-check]"),
  ];
  function progress() {
    document.querySelector("#check-progress")!.textContent =
      checks.filter((c) => c.checked).length +
      " of 3 reviewed · saved in this browser";
  }
  for (const check of checks) {
    try {
      check.checked =
        localStorage.getItem("truva-hub-" + check.dataset.check) === "true";
    } catch {}
    check.addEventListener("change", () => {
      try {
        localStorage.setItem(
          "truva-hub-" + check.dataset.check,
          String(check.checked),
        );
      } catch {}
      progress();
    });
  }
  progress();
  const copy = document.querySelector<HTMLButtonElement>("#copy-hub")!;
  copy.hidden = false;
  copy.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(
        new URL("/security-hub", location.origin).href,
      );
      document.querySelector("#copy-status")!.textContent = "Hub link copied.";
    } catch {
      document.querySelector("#copy-status")!.textContent =
        "Copy the address from your browser to share this hub.";
    }
  });
</script>
<style>
  .hub {
    padding-block: 16px 48px;
  }
  .hub-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-bottom: 32px;
  }
  .hub-heading h1 {
    font-size: clamp(34px, 3.8vw, 52px);
    margin: 10px 0;
  }
  .hub-heading p:not(.eyebrow) {
    color: var(--color-muted);
    font-size: 17px;
  }
  .hub-primary,
  .practitioner-link {
    white-space: nowrap;
  }
  .hub-layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 20px;
  }
  .hub-sidebar {
    border-right: 1px solid var(--color-line);
    padding-right: 22px;
  }
  .hub-sidebar nav {
    display: grid;
    gap: 5px;
    margin-top: 10px;
  }
  .hub-sidebar nav a {
    font-size: 13px;
    padding: 11px 8px;
    border-radius: 6px;
  }
  .hub-sidebar nav a:first-child {
    background: #edf2fa;
    color: #243a6c;
    font-weight: 700;
  }
  .sidebar-note {
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid var(--color-line);
    font-size: 12px;
  }
  .sidebar-note img {
    display: inline-block;
    vertical-align: middle;
    margin-right: 7px;
  }
  .sidebar-note p {
    margin-top: 12px;
    color: var(--color-muted);
  }
  .hub-content {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  .section-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .section-label h2,
  .start-panel h2,
  .share-panel h2 {
    font-size: 22px;
    letter-spacing: -0.025em;
  }
  .section-label > span,
  .section-label > a {
    font-size: 12px;
    color: #4d5d76;
  }
  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .topic-card {
    border: 1px solid #dae1eb;
    border-radius: 10px;
    padding: 20px;
    background: #f7f9fd;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .topic-icon {
    font-size: 26px;
    color: #243a6c;
    line-height: 1;
    margin-bottom: 20px;
  }
  .topic-card h3 {
    font-size: 20px;
    font-weight: 700;
  }
  .topic-card p {
    font-size: 13px;
    line-height: 1.6;
    color: #526077;
    margin: 10px 0 20px;
  }
  .card-link {
    font-size: 12px;
    font-weight: 700;
    color: #243a6c;
    margin-top: auto;
  }
  .start-panel {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 24px;
    padding: 24px;
    background: #fff6ef;
    border: 1px solid #f1daca;
    border-radius: 10px;
  }
  .start-panel h2 {
    margin-top: 10px;
  }
  .start-panel p {
    font-size: 12px;
    color: #665a52;
    line-height: 1.6;
    margin-top: 10px;
  }
  .checks label {
    display: flex;
    gap: 10px;
    font-size: 13px;
    line-height: 1.5;
    padding: 6px 0;
    cursor: pointer;
  }
  .checks input {
    accent-color: #243a6c;
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .library-tools {
    display: flex;
    gap: 12px;
    justify-content: space-between;
    flex-wrap: wrap;
  }
  .library-tools[hidden] {
    display: none;
  }
  .filters {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
  }
  .filters button {
    padding: 9px 11px;
    font-size: 12px;
    border: 1px solid #d7dfe9;
    border-radius: 6px;
    cursor: pointer;
    background: white;
  }
  .filters button[aria-pressed="true"] {
    background: #243a6c;
    color: white;
    border-color: #243a6c;
  }
  .search-label input {
    padding: 9px 12px;
    border: 1px solid #d7dfe9;
    border-radius: 6px;
    font-size: 12px;
    width: 190px;
  }
  .search-status {
    font-size: 11px;
    color: #586478;
    margin: 12px 0;
  }
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .guide-card {
    border: 1px solid #dae1eb;
    border-radius: 10px;
    overflow: hidden;
    background: white;
  }
  .guide-card[hidden] {
    display: none;
  }
  .guide-card > a {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .guide-art {
    height: 190px;
    background: #f4f7fb;
    overflow: hidden;
  }
  .guide-art img {
    width: 100%;
    height: auto;
  }
  .guide-copy {
    padding: 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .guide-card .eyebrow {
    font-size: 9px;
    letter-spacing: 0.08em;
  }
  .guide-card h3 {
    font-size: 19px;
    line-height: 1.25;
    margin: 10px 0;
  }
  .guide-card p {
    font-size: 12px;
    line-height: 1.6;
    color: #586478;
    margin-bottom: 18px;
  }
  .compact-guide {
    grid-column: 1/-1;
    background: #f7f9fd;
  }
  .compact-guide > a {
    padding: 20px;
  }
  .framework-tags {
    font-size: 12px;
    color: #243a6c;
    margin-bottom: 20px;
  }
  .compliance-panel {
    padding: 24px;
    border: 1px solid #dae1eb;
    border-radius: 10px;
  }
  .compliance-panel > p {
    font-size: 14px;
    color: #586478;
  }
  .framework-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: 25px 0;
  }
  .framework-grid .eyebrow {
    font-size: 9px;
  }
  .framework-grid h3 {
    font-size: 22px;
    margin: 8px 0;
  }
  .framework-grid p {
    font-size: 13px;
    line-height: 1.65;
    color: #586478;
  }
  .framework-grid a {
    font-size: 11px;
    text-decoration: underline;
    display: block;
    margin-top: 14px;
  }
  .source-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .source-grid a {
    border: 1px solid #dae1eb;
    padding: 18px;
    border-radius: 8px;
    display: grid;
    gap: 10px;
    font-size: 13px;
  }
  .source-grid span {
    font-size: 12px;
    color: #586478;
    line-height: 1.5;
  }
  .share-panel {
    background: #edf2fa;
    border-radius: 10px;
    padding: 24px;
    display: flex;
    gap: 20px;
    align-items: center;
    flex-wrap: wrap;
  }
  .share-panel > div {
    flex: 1;
    min-width: 200px;
  }
  .share-panel p {
    font-size: 13px;
    line-height: 1.6;
    margin-top: 10px;
  }
  .share-panel small {
    display: block;
    font-size: 10px;
    line-height: 1.5;
    margin-top: 14px;
    color: #526077;
  }
  .share-panel button {
    border: 0;
    cursor: pointer;
    font-size: 12px;
  }
  .hub a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hub :is(button, input):focus-visible {
    outline: 2px solid #243a6c;
    outline-offset: 3px;
  }
  @media (max-width: 1100px) {
    .hub-layout {
      grid-template-columns: 1fr;
    }
    .hub-sidebar {
      border: 0;
      padding: 0;
    }
    .hub-sidebar > p,
    .sidebar-note {
      display: none;
    }
    .hub-sidebar nav {
      display: flex;
      flex-wrap: wrap;
      margin: 0;
    }
    .hub-heading {
      align-items: flex-start;
    }
    .hub-sidebar nav a {
      padding: 8px;
    }
    .hub-layout {
      gap: 24px;
    }
  }
  @media (max-width: 767px) {
    .hub {
      padding-top: 12px;
    }
    .hub-heading {
      display: block;
    }
    .hub-sidebar {
      display: none;
    }
    .hub-primary {
      display: inline-flex;
      margin-top: 16px;
    }
    .hub-heading h1 {
      font-size: 36px;
    }
    .topic-grid,
    .guide-grid,
    .framework-grid,
    .source-grid {
      grid-template-columns: 1fr;
    }
    .topic-card {
      padding: 18px;
    }
    .topic-icon {
      margin-bottom: 12px;
    }
    .topic-card p {
      margin-bottom: 14px;
    }
    .start-panel {
      grid-template-columns: 1fr;
      padding: 20px;
    }
    .section-label {
      align-items: flex-start;
      flex-wrap: wrap;
    }
    .guide-art {
      height: 240px;
    }
    .compact-guide {
      grid-column: auto;
    }
    .compliance-panel {
      padding: 20px;
    }
    .framework-grid {
      gap: 26px;
    }
    .section-label h2 {
      font-size: 21px;
    }
    .search-label,
    .search-label input {
      width: 100%;
    }
  }
</style>
