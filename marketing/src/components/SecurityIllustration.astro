<svg
  class="security-map"
  viewBox="0 0 440 440"
  role="img"
  aria-labelledby="security-map-title security-map-description"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="security-map-title">Security for people, product, and process</title>
  <desc id="security-map-description">
    A central circle contains blue icons of a team, a product cube, and a
    repeatable process. Thin lines connect them to AI security, cloud security,
    and compliance.
  </desc>
  <g
    fill="none"
    stroke="#E77539"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M80 123v74q0 23 23 23h31M360 123v74q0 23-23 23h-31M220 306v31" />
    <circle cx="220" cy="220" r="86" />
  </g>
  <g fill="white" stroke="#E77539" stroke-width="1.5">
    <circle cx="80" cy="123" r="3" />
    <circle cx="360" cy="123" r="3" />
    <circle cx="220" cy="337" r="3" />
  </g>
  <g
    fill="none"
    stroke="#243A6C"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <!-- AI: a neural network within a processor. -->
    <g transform="translate(60 47)">
      <rect x="6" y="6" width="28" height="28" rx="5" />
      <path d="M13 1v5m14-5v5M13 34v5m14-5v5M1 13h5m-5 14h5m28-14h5m-5 14h5M14 15l12 10m0-10L14 25" />
      <g fill="white">
        <circle cx="14" cy="15" r="2" />
        <circle cx="26" cy="15" r="2" />
        <circle cx="14" cy="25" r="2" />
        <circle cx="26" cy="25" r="2" />
      </g>
    </g>
    <!-- Cloud. -->
    <path d="M347 80a11 11 0 0 1-1-22 14 14 0 0 1 27 2 10 10 0 0 1-1 20h-25Z" />
    <!-- Compliance: checked evidence. -->
    <path d="M209 353h15l7 7v28h-22v-35Zm15 0v8h7m-16 9 3 3 7-7m-10 15h10" />
    <!-- People: a team of three. -->
    <g transform="translate(195 160)">
      <circle cx="25" cy="11" r="6" />
      <path d="M14 36v-5a11 11 0 0 1 22 0v5H14Z" />
      <path d="M10 10a5 5 0 1 0 0 10M7 25a8 8 0 0 0-5 7v3h7M40 10a5 5 0 1 1 0 10m3 5a8 8 0 0 1 5 7v3h-7" />
    </g>
    <!-- Product: an isometric cube. -->
    <g transform="translate(166 224)">
      <path d="m20 1 18 10v22L20 43 2 33V11L20 1Zm0 20 18-10M20 21 2 11m18 10v22M11 6l18 10v9" />
    </g>
    <!-- Process: a repeatable cycle with directional arrows. -->
    <g transform="translate(235 224)">
      <path d="M4 17A17 17 0 0 1 34 9l4 5M38 5v9H29M38 27A17 17 0 0 1 8 35l-4-5m0 9v-9h9" />
      <circle cx="21" cy="22" r="4" />
    </g>
  </g>
  <g
    fill="#243A6C"
    text-anchor="middle"
    font-family="Arial, Helvetica, sans-serif"
    font-size="20"
  >
    <text x="80" y="109">
      AI security
    </text>
    <text x="360" y="109">
      Cloud security
    </text>
    <text x="220" y="417">
      Compliance
    </text>
  </g>
</svg>
<style>
  .security-map {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
