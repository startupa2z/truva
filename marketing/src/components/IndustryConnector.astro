---
import { hubPath, weekArticles } from "../data/sf-tech-week";

const lead = weekArticles[0];
const fieldNotes = [
  { label: "AI & AGENTS", article: weekArticles.find((item) => item.slug === "sovereign-ai-data-context-control")! },
  { label: "FOUNDER FINANCE", article: weekArticles.find((item) => item.slug === "financial-systems-for-founders")! },
  { label: "CUSTOMERS & BRAND", article: weekArticles.find((item) => item.slug === "built-by-community-reddit")! },
];
---

<section id="industry-connector" class="industry-connector" aria-labelledby="industry-title">
  <div class="industry-heading">
    <div>
      <p class="eyebrow">INDUSTRY CONNECTOR · FIELD NOTES</p>
      <h2 id="industry-title">From SF Tech Week, straight to the questions that matter</h2>
    </div>
    <a href={hubPath}>Explore all 13 recaps</a>
  </div>
  <div class="industry-body">
    <a class="lead-image" href={`${hubPath}/${lead.slug}`} aria-label="Read the SF Tech Week lead story">
      {lead.image && <img src={lead.image.src} width={lead.image.width} height={lead.image.height} alt={lead.image.alt} loading="lazy" decoding="async" />}
    </a>
    <div class="lead-copy">
      <span class="story-tag">THE WEEK IN ONE STORY</span>
      <h3><a href={`${hubPath}/${lead.slug}`}>What SF Tech Week changed about the questions I ask founders</a></h3>
      <p>Firsthand notes on AI, security, customers, brand and the decisions founders make as they grow.</p>
      <a class="read-link" href={`${hubPath}/${lead.slug}`}>Read the lead story</a>
    </div>
  </div>
  <div class="field-notes" aria-label="Selected SF Tech Week reports">
    {fieldNotes.map(({ label, article }) => (
      <a href={`${hubPath}/${article.slug}`}>
        <span>{label}</span>
        <strong>{article.shortTitle}</strong>
      </a>
    ))}
  </div>
</section>

<style>
  .industry-connector { border: 1px solid #dbe1ea; border-top: 3px solid #243a6c; border-radius: 10px; background: #fff; overflow: hidden; }
  .industry-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; padding: 18px 20px 16px; }
  .industry-heading .eyebrow { color: #41577b; font-size: 10px; letter-spacing: .14em; margin: 0 0 8px; }
  .industry-heading h2 { font-size: clamp(19px, 2vw, 25px); line-height: 1.2; letter-spacing: -.025em; max-width: 24ch; }
  .industry-heading > a { color: #243a6c; flex: none; font-size: 12px; font-weight: 700; padding-bottom: 3px; text-decoration: underline; text-underline-offset: 3px; }
  .industry-body { border-top: 1px solid #e6eaf0; display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1fr); min-height: 204px; }
  .lead-image { display: block; overflow: hidden; background: #edf2fa; }
  .lead-image img { display: block; height: 100%; max-height: 250px; min-height: 204px; object-fit: cover; width: 100%; }
  .lead-copy { display: flex; flex-direction: column; align-items: start; justify-content: center; padding: 20px 24px; }
  .story-tag, .field-notes span:first-child { color: #5a6880; font-size: 10px; font-weight: 800; letter-spacing: .12em; }
  .lead-copy h3 { font-size: clamp(19px, 2.1vw, 27px); line-height: 1.17; letter-spacing: -.025em; margin: 9px 0 8px; }
  .lead-copy p { color: #526077; font-size: 12px; line-height: 1.55; margin: 0 0 10px; }
  .read-link { color: #243a6c; font-size: 12px; font-weight: 700; margin-top: auto; }
  .field-notes { border-top: 1px solid #e6eaf0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .field-notes a { display: grid; gap: 4px; min-height: 80px; padding: 13px 16px; }
  .field-notes a + a { border-left: 1px solid #e6eaf0; }
  .field-notes strong { font-size: 12px; line-height: 1.3; }
  .industry-connector a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .industry-connector a:focus-visible { outline: 2px solid #243a6c; outline-offset: -2px; }
  @media (max-width: 680px) {
    .industry-heading { align-items: start; flex-direction: column; gap: 8px; }
    .industry-body { grid-template-columns: 1fr; }
    .lead-image img { height: 170px; max-height: none; min-height: 0; }
    .lead-copy { padding: 18px 20px; }
    .field-notes { grid-template-columns: 1fr; }
    .field-notes a { min-height: 62px; }
    .field-notes a + a { border-left: 0; border-top: 1px solid #e6eaf0; }
  }
</style>
