---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
type Item = { id:string; title:string; url:string; source:string; topic:string; publishedAt:string; summary:string; severity?:string };
let items: Item[] = [];
try { items = JSON.parse(readFileSync(resolve("public/security-feed.json"), "utf8")).items.slice(0, 40); } catch {}
const vendors = [["Wiz", "Cloud risk context", "Explore misconfiguration assessment and risk prioritization using connected cloud context.", "https://www.wiz.io/solutions/cspm"], ["Prowler", "Open-source assessment", "Explore security checks, remediation guidance and compliance mappings, with CLI and self-hosted options.", "https://docs.prowler.com/introduction"], ["Orca", "Cloud posture management", "Explore cloud misconfiguration detection, prioritization and remediation guidance.", "https://orca.security/platform/cloud-security-posture-management-cspm/"]];
---
<div class="dashboard-grid">
  <section id="priority-signals" class="priority-panel" aria-labelledby="priority-title">
    <div class="panel-heading"><div><p class="eyebrow">PRIORITY QUEUE</p><h2 id="priority-title">Latest signals</h2></div><span>Newest first · current snapshot</span></div>
    <div id="feed-controls" class="feed-controls" hidden><div role="group" aria-label="Advisory topic"><button data-feed-filter="all" aria-pressed="true">All advisories</button><button data-feed-filter="ai" aria-pressed="false">AI packages</button><button data-feed-filter="cloud" aria-pressed="false">Cloud &amp; software</button></div><label>Search advisories<input id="feed-search" type="search" placeholder="CVE, package or keyword…" /></label></div>
    <p id="feed-status" class="feed-caption" role="status">Saved snapshot · {items.length} advisories</p>
    <div id="feed-grid" class="priority-list">{items.slice(0, 6).map((item) => <article class="priority-row"><div class="priority-topic"><span>{item.topic === "ai" ? "AI security" : "Cloud & software"}</span><small>{item.severity || "Advisory"}</small></div><div><h3><a href={item.url}>{item.title}</a></h3><p>{item.summary}</p></div><div class="priority-meta"><span>{item.source}</span><time datetime={item.publishedAt}>{item.publishedAt.slice(0, 10)}</time><a href={item.url}>Read original ↗</a></div></article>)}</div>
    <p id="feed-empty" hidden={items.length > 0}>No source data available yet. Explore the guides below.</p><button id="feed-more" class="feed-more" hidden>Show more advisories</button>
  </section>
  <aside class="dashboard-detail" aria-label="Actions and source health"><section class="check-next" aria-labelledby="check-next-title"><p class="eyebrow">WHAT TO CHECK NEXT</p><h2 id="check-next-title">Turn a signal into a review.</h2><p>Source-backed editorial guidance is being prepared. Until then, open the original advisory and review the affected technology and remediation guidance.</p></section><section id="source-health" class="source-health" aria-labelledby="source-health-title"><div class="panel-heading"><h2 id="source-health-title">Source health</h2><span>Live status</span></div><ul id="feed-source-status"><li>Loading source status…</li></ul><p id="feed-freshness" class="feed-caption">Review affected versions and source guidance before acting.</p></section></aside>
</div>
<section id="ai-security" class="dashboard-lower" aria-labelledby="signal-mix-title"><article class="signal-mix"><p class="eyebrow">SIGNAL MIX</p><h2 id="signal-mix-title">Current snapshot</h2><div><strong id="feed-total">{items.length}</strong><span>advisories</span></div><div class="mix-bars" aria-label="Current advisory counts by topic"><span><i id="feed-ai-bar"></i>AI packages</span><span><i id="feed-cloud-bar"></i>Cloud &amp; software</span></div><p class="feed-caption">Counts classify only the displayed source snapshot.</p></article><article class="posture-example"><p class="eyebrow">ILLUSTRATIVE POSTURE VIEW</p><h2>Where a private assessment would focus.</h2><p class="illustrative-label">Illustrative public example — not your environment</p><ul><li><span>Identity</span><i></i></li><li><span>Exposed services</span><i></i></li><li><span>Data protection</span><i></i></li><li><span>Evidence readiness</span><i></i></li></ul></article></section>
<section id="cloud-tools" aria-labelledby="tools-title"><p class="eyebrow">CSPM / CNAPP KNOWLEDGE</p><h2 id="tools-title">Understand your cloud security options.</h2><p class="tools-lead">CSPM helps identify cloud configuration risks. CNAPP brings multiple cloud application security capabilities together. Start with your environment, ownership and remediation workflow.</p><div class="vendor-grid">{vendors.map(([name, label, summary, url]) => <article class="vendor-card"><span>{label}</span><h3>{name}</h3><p>{summary}</p><a href={url}>Explore official resources ↗</a></article>)}</div><p class="feed-caption">Independent learning resources. Vendor links are not endorsements or partnership claims. Confirm capabilities and commercial terms with each provider.</p><a class="tools-guide" href="/blog/top-10-cspm-issues">Start with Truva’s cloud posture checklist →</a></section>
<script>
  type FeedItem = { id:string; title:string; url:string; source:string; topic:string; publishedAt:string; summary:string; severity?:string };
  type Source = { name:string; status:string; lastSuccessAt:string|null };
  const grid=document.querySelector<HTMLElement>("#feed-grid")!, search=document.querySelector<HTMLInputElement>("#feed-search")!, status=document.querySelector<HTMLElement>("#feed-status")!, more=document.querySelector<HTMLButtonElement>("#feed-more")!, empty=document.querySelector<HTMLElement>("#feed-empty")!, filters=[...document.querySelectorAll<HTMLButtonElement>("[data-feed-filter]")]; let data:FeedItem[]=[], selected="all", limit=6, loaded=false;
  const date=(value:string|null)=>value&&Number.isFinite(Date.parse(value))?new Date(value).toLocaleString("en-US",{dateStyle:"medium",timeStyle:"short",timeZone:"UTC"})+" UTC":"Not yet retrieved";
  const safe=(value:string)=>{try{const url=new URL(value);return url.protocol==="https:"&&!url.username&&!url.password;}catch{return false;}};
  const node=(tag:string,className:string,value:string)=>{const element=document.createElement(tag);element.className=className;element.textContent=value;return element;};
  function render(){const query=search.value.trim().toLowerCase(), rows=data.filter((item)=>(selected==="all"||item.topic===selected)&&`${item.title} ${item.summary} ${item.source}`.toLowerCase().includes(query));grid.replaceChildren();for(const item of rows.slice(0,limit)){const row=node("article","priority-row",""),topic=node("div","priority-topic","");topic.append(node("span","",item.topic==="ai"?"AI security":"Cloud & software"),node("small","",item.severity||"Advisory"));const content=node("div","","");const heading=node("h3","","");const link=document.createElement("a");link.href=item.url;link.rel="noopener noreferrer";link.textContent=item.title;heading.append(link);content.append(heading,node("p","",item.summary.slice(0,220)));const meta=node("div","priority-meta","");const original=document.createElement("a");original.href=item.url;original.rel="noopener noreferrer";original.textContent="Read original ↗";meta.append(node("span","",item.source),node("time","",date(item.publishedAt)),original);row.append(topic,content,meta);grid.append(row);}status.textContent=`Showing ${Math.min(limit,rows.length)} of ${rows.length} matching advisories`;empty.hidden=rows.length>0;empty.textContent=data.length?"No matching advisories. Try another keyword or topic.":"No source data is available yet. Explore the guides below.";more.hidden=rows.length<=limit;}
  async function load(){try{const response=await fetch("/security-feed.json",{cache:"no-store",signal:AbortSignal.timeout(10000)});if(!response.ok)throw Error();const feed=await response.json();if(!Array.isArray(feed.items)||!Array.isArray(feed.sources))throw Error();data=feed.items.filter((item:FeedItem)=>typeof item.title==="string"&&typeof item.summary==="string"&&safe(item.url)&&Number.isFinite(Date.parse(item.publishedAt))).slice(0,40);const sources:Source[]=feed.sources,ai=data.filter((item)=>item.topic==="ai").length,cloud=data.length-ai;document.querySelector("#feed-total")!.textContent=String(data.length);const bars=[document.querySelector<HTMLElement>("#feed-ai-bar")!,document.querySelector<HTMLElement>("#feed-cloud-bar")!],scale=Math.max(data.length,1);bars[0].style.width=`${Math.max(8,Math.round(ai/scale*100))}%`;bars[1].style.width=`${Math.max(8,Math.round(cloud/scale*100))}%`;const list=document.querySelector("#feed-source-status")!;list.replaceChildren();for(const source of sources)list.append(node("li","",`${source.name}: ${source.status==="ok"?"retrieved":"unavailable; last saved items retained if present"}. Last successful retrieval: ${date(source.lastSuccessAt)}.`));const stale=sources.some((source)=>source.status!=="ok"||!source.lastSuccessAt||!Number.isFinite(Date.parse(source.lastSuccessAt))||Date.now()-Date.parse(source.lastSuccessAt)>86400000);document.querySelector("#feed-freshness")!.textContent=`${stale?"Some source data is unavailable or older than 24 hours. ":"All current sources reported a successful recent retrieval. "}Snapshot attempt: ${date(feed.fetchedAt)}.`;document.querySelector<HTMLElement>("#feed-controls")!.hidden=false;loaded=true;render();}catch{status.textContent=loaded?"Cannot retrieve a newer snapshot. Keeping the last displayed advisories.":"Feed unavailable. Showing any saved advisories above; guides remain available.";}}
  filters.forEach((button)=>button.addEventListener("click",()=>{selected=button.dataset.feedFilter!;limit=6;filters.forEach((item)=>item.setAttribute("aria-pressed",String(item===button)));render();}));search.addEventListener("input",()=>{limit=6;render();});more.addEventListener("click",()=>{limit+=6;render();});void load();setInterval(()=>{if(!document.hidden)void load();},60000);
</script>
<style is:global>
.priority-panel,.dashboard-detail>section,.dashboard-lower>article{border:1px solid #dbe1ea;border-radius:10px;background:#fff}.panel-heading{display:flex;justify-content:space-between;gap:18px;align-items:start}.panel-heading h2,.check-next h2,.dashboard-lower h2{font-size:24px;line-height:1.2;margin-top:8px}.panel-heading>span,.feed-caption{font-size:11px;color:#526077}.dashboard-grid{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:18px}.priority-panel{padding:22px;min-width:0}.priority-list{display:grid;margin-top:14px}.priority-row{display:grid;grid-template-columns:105px minmax(0,1fr) 126px;gap:14px;padding:16px 0;border-top:1px solid #e7ebf1}.priority-topic{display:grid;gap:6px;font-size:11px;color:#43577c}.priority-topic span{font-weight:700}.priority-topic small{color:#665a52}.priority-row h3{font-size:15px;line-height:1.35;font-weight:700}.priority-row p{font-size:12px;line-height:1.5;color:#526077;margin-top:7px}.priority-meta{display:grid;align-content:start;gap:6px;font-size:11px;color:#526077}.priority-meta a{font-weight:700;color:#243a6c;min-height:28px}.dashboard-detail{display:grid;gap:18px}.dashboard-detail>section{padding:18px}.check-next{background:#fff6ef!important;border-color:#f1daca!important}.check-next p:not(.eyebrow){font-size:12px;line-height:1.6;color:#665a52;margin-top:12px}.source-health ul{display:grid;gap:12px;padding:0;margin:16px 0;list-style:none}.source-health li{font-size:12px;line-height:1.55;border-top:1px solid #e7ebf1;padding-top:12px}.dashboard-lower{display:grid;grid-template-columns:1fr 1.2fr;gap:18px}.dashboard-lower>article{padding:22px}.signal-mix>div:not(.mix-bars){display:flex;align-items:baseline;gap:10px;margin:18px 0}.signal-mix strong{font-size:40px;color:#243a6c}.signal-mix span{font-size:12px;color:#526077}.mix-bars{display:grid;gap:10px}.mix-bars span{display:grid;grid-template-columns:115px 1fr;gap:8px;align-items:center;font-size:12px}.mix-bars i{display:block;height:9px;background:#243a6c;border-radius:10px;min-width:8%}.mix-bars span+span i{background:#e77539}.illustrative-label{font-size:12px!important;color:#6a4b34!important;font-weight:700;margin:12px 0!important}.posture-example ul{display:grid;gap:11px;padding:0;margin:18px 0 0;list-style:none}.posture-example li{display:grid;grid-template-columns:130px 1fr;gap:10px;align-items:center;font-size:12px}.posture-example li i{height:8px;border-radius:8px;background:linear-gradient(90deg,#d6dfec 62%,#edf0f5 62%)}.posture-example li:nth-child(2) i{background:linear-gradient(90deg,#d6dfec 46%,#edf0f5 46%)}.posture-example li:nth-child(3) i{background:linear-gradient(90deg,#d6dfec 70%,#edf0f5 70%)}.posture-example li:nth-child(4) i{background:linear-gradient(90deg,#d6dfec 53%,#edf0f5 53%)}.feed-controls{display:flex;justify-content:space-between;align-items:end;gap:15px;flex-wrap:wrap;margin-top:18px}.feed-controls[hidden]{display:none}.feed-controls>div{display:flex;flex-wrap:wrap;gap:6px}.feed-controls button,.feed-more{border:1px solid #ccd5e3;border-radius:6px;background:#fff;min-height:44px;padding:10px 12px;font-size:13px;cursor:pointer}.feed-controls button[aria-pressed=true]{background:#243a6c;color:#fff;border-color:#243a6c}.feed-controls label{display:grid;gap:5px;font-size:12px;color:#526077;flex:1;max-width:290px}.feed-controls input{min-height:44px;width:100%;border:1px solid #c5cede;border-radius:6px;padding:8px 12px;font-size:14px;color:#292929;background:white}.feed-more{margin-top:18px}.feed-more[hidden],#feed-empty[hidden]{display:none}#feed-empty{padding:24px;background:#f7f9fc;font-size:14px}.vendor-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.vendor-card{border:1px solid #dbe1ea;border-radius:8px;padding:22px 18px;display:flex;flex-direction:column;gap:12px}.vendor-card>span{font-size:11px;font-weight:700;color:#6a4b34}.vendor-card h3{font-size:25px;color:#243a6c}.vendor-card p,.tools-lead{font-size:13px;color:#526077}.vendor-card>a,.tools-guide{font-size:12px;font-weight:700;color:#243a6c;min-height:44px;padding-top:10px;margin-top:auto}.tools-guide{display:inline-block}#priority-signals,#source-health,#ai-security,#cloud-tools{scroll-margin-top:110px}@media(max-width:1100px){.dashboard-grid{grid-template-columns:1fr}.dashboard-detail{grid-template-columns:1fr 1fr}.vendor-grid{grid-template-columns:1fr}}@media(max-width:767px){.panel-heading{display:block}.dashboard-detail{grid-template-columns:1fr}.priority-panel{padding:18px}.priority-row{grid-template-columns:1fr;gap:9px}.priority-meta{grid-template-columns:repeat(3,minmax(0,1fr));align-items:center}.feed-controls{display:block}.feed-controls label{max-width:none;margin-top:14px}.posture-example li{grid-template-columns:115px 1fr}}
</style>
<style is:global>
@media(max-width:767px){.dashboard-lower{grid-template-columns:1fr}}
</style>
