---
import BookingLink from "./BookingLink.astro";
const offerings = [
  {
    title: "AI security",
    text: "Evaluate AI applications and agents. Turn findings into a practical hardening plan.",
    href: "/services#ai-security",
  },
  {
    title: "Cloud security",
    text: "Review cloud exposure, permissions, and configuration. Prioritize the fixes that matter.",
    href: "/services#cloud-security",
  },
  {
    title: "Governance & compliance",
    text: "Connect policies, controls, and evidence to your readiness goals.",
    href: "/services#compliance",
  },
];
const markets = [
  {
    title: "Healthcare, finance & legal",
    text: "Protect sensitive information and respond to regulatory and customer expectations.",
  },
  {
    title: "Small & mid-size businesses",
    text: "Add security expertise without building a full internal team.",
  },
  {
    title: "SaaS & technology startups",
    text: "Prepare for enterprise reviews and secure new AI capabilities.",
  },
];
const differences = [
  {
    title: "Direct practitioner access",
    text: "Work directly with the people assessing your systems.",
  },
  {
    title: "Connected expertise",
    text: "Bring AI, cloud, and governance into one engagement.",
  },
  {
    title: "Actionable delivery",
    text: "Leave with prioritized fixes, clear ownership, and useful documentation.",
  },
  {
    title: "Scope that fits",
    text: "Agree priorities and scope around your business needs.",
  },
];
---

<section
  id="what-we-do"
  class="company-section shell"
  aria-labelledby="what-title"
>
  <div class="company-heading">
    <p class="eyebrow">WHAT WE DO</p>
    <h2 id="what-title">
      Secure the technology.
      <br />
      Strengthen the way you work.
    </h2>
  </div>
  <div class="offering-list">
    {offerings.map((o, i) => (
      <a href={o.href}>
        <span class="row-number">0{i + 1}</span>
        <h3>{o.title}</h3>
        <p>{o.text}</p>
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</section>
<section
  id="who-we-serve"
  class="audience-section section-border"
  aria-labelledby="audience-title"
>
  <div class="shell audience-layout">
    <div class="company-heading">
      <p class="eyebrow">WHO WE SERVE</p>
      <h2 id="audience-title">
        For businesses with
        <br />
        more at stake.
      </h2>
    </div>
    <div class="audience-list">
      {markets.map((m) => (
        <article>
          <h3>{m.title}</h3>
          <p>{m.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<section
  id="why-truva"
  class="company-section shell"
  aria-labelledby="why-title"
>
  <div class="company-heading">
    <p class="eyebrow">WHAT SETS US APART</p>
    <h2 id="why-title">
      Close to your team.
      <br />
      Focused on the work.
    </h2>
  </div>
  <div class="difference-list">
    {differences.map((d, i) => (
      <article>
        <span class="row-number">0{i + 1}</span>
        <div>
          <h3>{d.title}</h3>
          <p>{d.text}</p>
        </div>
      </article>
    ))}
  </div>
</section>
<section
  id="about"
  class="about-section section-border"
  aria-labelledby="about-title"
>
  <div class="shell about-layout">
    <div class="about-brand">
      <img
        src="/images/truva-mark.webp"
        width="76"
        height="82"
        alt="Truva Solutions logo"
      />
      <p>Truva Solutions LLC</p>
      <span>People. Product. Process.</span>
    </div>
    <div>
      <p class="eyebrow">ABOUT TRUVA SOLUTIONS</p>
      <h2 id="about-title">Built for the gap.</h2>
      <p class="about-copy">
        Truva serves growing businesses, emerging government contractors, and
        technology teams that need practical security expertise. We pair
        assessments with clear guidance and audit-ready documentation, helping
        your team move from findings to action.
      </p>
      <BookingLink label="Book a consult" />
    </div>
  </div>
</section>
<style>
  .company-section {
    padding-block: 72px;
  }
  .company-heading {
    margin-bottom: 32px;
  }
  .company-heading h2,
  .about-layout h2 {
    font-size: clamp(32px, 3.5vw, 46px);
    line-height: 1.13;
    margin-top: 14px;
    letter-spacing: -0.045em;
  }
  .offering-list {
    border-top: 1px solid var(--color-line);
  }
  .offering-list > a {
    display: grid;
    grid-template-columns: 45px 1fr 1.4fr 25px;
    gap: 24px;
    align-items: center;
    padding: 26px 0;
    border-bottom: 1px solid var(--color-line);
    min-height: 110px;
  }
  .row-number {
    font-size: 13px;
    color: var(--color-brand-blue);
  }
  .offering-list h3,
  .audience-list h3,
  .difference-list h3 {
    font-size: 22px;
    line-height: 1.25;
  }
  .offering-list p,
  .audience-list p,
  .difference-list p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-muted);
  }
  .offering-list a:hover h3 {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .audience-section {
    background: #f5f7fb;
    padding-block: 64px;
  }
  .audience-layout {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 72px;
  }
  .audience-list article {
    padding: 24px 0;
    border-bottom: 1px solid #dbe1eb;
  }
  .audience-list article:first-child {
    padding-top: 0;
  }
  .audience-list p {
    margin-top: 10px;
  }
  .difference-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px 64px;
  }
  .difference-list article {
    display: flex;
    gap: 24px;
    border-top: 1px solid var(--color-line);
    padding-top: 24px;
  }
  .difference-list p {
    margin-top: 10px;
  }
  .about-section {
    padding-block: 64px;
  }
  .about-layout {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 72px;
    align-items: center;
  }
  .about-brand {
    background: #f5f7fb;
    padding: 45px;
    border-radius: 8px;
  }
  .about-brand p {
    font-size: 25px;
    margin-top: 22px;
    font-weight: 700;
  }
  .about-brand span {
    display: block;
    margin-top: 10px;
    font-size: 13px;
    color: var(--color-brand-blue);
  }
  .about-copy {
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-muted);
    margin: 24px 0;
  }
  .about-layout :global(.button) {
    margin-top: 4px;
  }
  @media (max-width: 767px) {
    .company-section {
      padding-block: 48px;
    }
    .offering-list > a {
      grid-template-columns: 25px 1fr 20px;
      gap: 12px;
      padding: 22px 0;
    }
    .offering-list p {
      grid-column: 2;
      grid-row: 2;
    }
    .offering-list > a > span:last-child {
      grid-column: 3;
      grid-row: 1;
    }
    .audience-layout,
    .about-layout,
    .difference-list {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .audience-section,
    .about-section {
      padding-block: 48px;
    }
    .audience-layout .company-heading {
      margin-bottom: 0;
    }
    .about-brand {
      padding: 28px;
    }
    .difference-list h3,
    .audience-list h3,
    .offering-list h3 {
      font-size: 21px;
    }
  }
</style>
