---
import "../styles/global.css";
import VisitTracker from "../components/VisitTracker.astro";
import { site } from "../data/site";
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  extraSchema?: Record<string, unknown>[];
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}
const {
  title,
  description,
  canonicalPath,
  extraSchema = [],
  ogImage = "/images/og-home.png",
  ogImageAlt = "Truva Solutions: Startup security. Confidence to grow.",
  ogType = "website",
  ogImageWidth = 1200,
  ogImageHeight = 630,
} = Astro.props;
const canonical = new URL(canonicalPath || Astro.url.pathname, site.url).href;
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": `${site.url}/#organization`,
      name: site.legalName,
      url: site.url,
      logo: `${site.url}/images/truva-mark.webp`,
      email: site.email,
      areaServed: { "@type": "Country", name: "United States" },
      description:
        "AI security, cloud security, and compliance consulting for startups and SaaS companies.",
    },
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      name: site.name,
      url: site.url,
      publisher: { "@id": `${site.url}/#organization` },
    },
    ...extraSchema,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        site.preview ||
        Astro.url.pathname.startsWith("/admin") ||
        Astro.url.pathname.startsWith("/design-system")
          ? "noindex, nofollow"
          : "index, follow"
      }
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}${ogImage}`} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}${ogImage}`} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(graph).replace(/</g, "\\u003c")}
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
    <VisitTracker />
  </body>
</html>
