---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BookingLink from "../../components/BookingLink.astro";
import { risks, sources } from "../../data/ai-security-article";
const title = "Top 10 AI Security Issues to Address | Truva Solutions";
const description =
  "Ten AI security issues explained with practical examples, first actions, and evidence to collect. A guide for founders and security teams.";
const words = risks
  .map((risk) =>
    [risk.title, risk.body, risk.example, ...risk.actions, risk.evidence].join(
      " ",
    ),
  )
  .join(" ")
  .split(/\s+/).length;
const minutes = Math.ceil((words + 350) / 220);
---

<Base title={title} description={description}>
  <SiteHeader />
  <main id="main" class="ai-article">
    <header class="article-hero shell">
      <div class="article-hero-grid">
        <a class="article-back" href="/resources">
          Back to Resources
        </a>
        <p class="eyebrow">PRACTICAL AI SECURITY GUIDE</p>
        <h1>
          10 AI security issues <span>to check now.</span>
        </h1>
        <p class="article-deck">
          See what each risk looks like, what to do first, and what evidence to
          keep, in clear language your team can use.
        </p>
        <p class="guide-value">
          Clear examples · First actions · Evidence to keep
        </p>
        <div class="article-meta">
          <span>Truva Solutions</span>
          <span>{minutes} min read</span>
          <span>Guide · 19 Sep 2026</span>
        </div>
      </div>
    </header>
    <div class="article-layout shell">
      <article class="article-body" aria-label="AI security guide">
        <figure class="article-lead-visual">
          <img
            src="/images/ai-security-risk-map.svg"
            alt="Ten AI security issues grouped into visibility, data, capability, and trust review areas"
            width="1200"
            height="675"
          />
          <figcaption>
            A practical map of the ten issues covered in this guide.
          </figcaption>
        </figure>
        <div class="article-intro">
          <h2>Start with what AI can access and change.</h2>
          <p>
            Map the data, people, tools, and decisions around each AI use case.
            A chatbot answering public questions needs different controls from
            an agent that can update customer records.
          </p>
          <p>
            Use this as a practical review list, not a ranking. Start with
            issues that could expose sensitive data, cross customer boundaries,
            or let AI take high-impact actions.
          </p>
        </div>
        <section class="guide-metrics" aria-label="Guide at a glance">
          <div>
            <strong>10</strong>
            <span>risk areas</span>
          </div>
          <div>
            <strong>20</strong>
            <span>first actions</span>
          </div>
          <div>
            <strong>10</strong>
            <span>evidence items</span>
          </div>
          <div>
            <strong>3</strong>
            <span>steps for week one</span>
          </div>
        </section>
        <section class="decision-table" aria-labelledby="priority-table-title">
          <p class="eyebrow">PRIORITIZE THE REVIEW</p>
          <h2 id="priority-table-title">
            Start with the highest impact workflow.
          </h2>
          <div
            class="table-scroll"
            role="region"
            aria-label="AI security prioritization table"
            tabindex="0"
          >
            <table>
              <thead>
                <tr>
                  <th>Look for</th>
                  <th>Why it moves first</th>
                  <th>Begin with</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Sensitive data</td>
                  <td>
                    A mistake could expose customer, employee, or company
                    information.
                  </td>
                  <td>Issues 2 and 7</td>
                </tr>
                <tr>
                  <td>Write access</td>
                  <td>
                    The AI can change records, send messages, or trigger
                    transactions.
                  </td>
                  <td>Issues 4 and 8</td>
                </tr>
                <tr>
                  <td>External content</td>
                  <td>
                    Files, email, or webpages may try to redirect the workflow.
                  </td>
                  <td>Issues 5 and 6</td>
                </tr>
                <tr>
                  <td>No clear owner</td>
                  <td>
                    Gaps stay open because no one owns review, evidence, or
                    change control.
                  </td>
                  <td>Issues 1 and 10</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
        <figure class="article-visual">
          <img
            src="/images/ai-security-review-path.svg"
            alt="Four-stage AI security review path covering input, context, tools, and action"
            width="1200"
            height="620"
            loading="lazy"
          />
          <figcaption>
            Review one workflow from its input to its final action. A control
            gap at any stage can affect the outcome.
          </figcaption>
        </figure>
        {risks.map((risk, i) => (
          <section
            class="risk-detail"
            id={risk.id}
            aria-labelledby={`${risk.id}-title`}
          >
            <div class="risk-heading">
              <h2 id={`${risk.id}-title`}>
                <span class="risk-heading-number">{i + 1}.</span>
                <span class="risk-heading-title">{risk.title}</span>
              </h2>
            </div>
            <p>{risk.body}</p>
            <div class="risk-example">
              <span class="mini-label">REAL-WORLD EXAMPLE</span>
              <p>{risk.example}</p>
            </div>
            <h3>What to do first</h3>
            <ul>
              {risk.actions.map((action) => (
                <li>{action}</li>
              ))}
            </ul>
            <p class="risk-evidence">
              <strong>Keep this evidence</strong>
              {risk.evidence}
            </p>
          </section>
        ))}
        <section class="evidence-map" aria-labelledby="evidence-map-title">
          <p class="eyebrow">MAKE THE REVIEW PROVABLE</p>
          <h2 id="evidence-map-title">A compact control and evidence map.</h2>
          <div
            class="table-scroll"
            role="region"
            aria-label="AI controls and evidence table"
            tabindex="0"
          >
            <table>
              <thead>
                <tr>
                  <th>Focus</th>
                  <th>Issues</th>
                  <th>Useful evidence</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Ownership and change</td>
                  <td>1, 10</td>
                  <td>AI inventory, named owners, and change approvals</td>
                </tr>
                <tr>
                  <td>Data and retrieval</td>
                  <td>2, 7</td>
                  <td>Data-flow map and role-based retrieval tests</td>
                </tr>
                <tr>
                  <td>Applications and tools</td>
                  <td>3, 4, 6</td>
                  <td>
                    Access tests, tool permissions, and dependency inventory
                  </td>
                </tr>
                <tr>
                  <td>Inputs and actions</td>
                  <td>5, 8</td>
                  <td>Adversarial tests and approval-gate results</td>
                </tr>
                <tr>
                  <td>Operations</td>
                  <td>9</td>
                  <td>A reconstructed run from request to final action</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
        <section class="first-week" id="first-week">
          <p class="eyebrow">TURN THE LIST INTO ACTION</p>
          <h2>Your first week: one workflow, end to end.</h2>
          <p>
            You do not need to review every system at once. Start with a
            workflow that handles sensitive data or can change something
            important.
          </p>
          <ol>
            <li>
              <strong>Map it.</strong> Identify the owner, data sources, model,
              identity, and connected tools.
            </li>
            <li>
              <strong>Challenge it.</strong> Test unauthorized access, malicious
              inputs, and actions that should require approval.
            </li>
            <li>
              <strong>Fix and prove it.</strong> Assign the highest-impact gaps,
              retest the controls, and keep the evidence.
            </li>
          </ol>
          <p>
            These controls reduce risk; they do not make a model immune to
            manipulation. Keep reassessing as capabilities change.
          </p>
        </section>
        <section class="article-sources" id="sources">
          <h2>References</h2>
          <ul>
            {Object.values(sources).map((source) => (
              <li>
                <a href={source.url}>{source.name}</a>
              </li>
            ))}
          </ul>
          <p>
            The OWASP LLM references use the 2025 edition; API references use
            the 2023 edition. Framework dates identify the sources, not a new
            2026 OWASP ranking. NIST’s framework is voluntary guidance, not a
            certification.
          </p>
        </section>
      </article>
      <aside class="article-sidebar">
        <nav aria-label="Table of contents">
          <p class="eyebrow">TABLE OF CONTENTS</p>
          {risks.map((risk, i) => (
            <a href={`#${risk.id}`}>
              <span>{i + 1}</span>
              {risk.short}
            </a>
          ))}
          <a href="#first-week">
            <span>11</span>Your first week
          </a>
          <a href="#sources">
            <span>12</span>References
          </a>
        </nav>
      </aside>
    </div>
    <section class="article-cta shell">
      <div>
        <p class="eyebrow">MAKE THE NEXT STEP PRACTICAL</p>
        <h2>
          Which gaps matter
          <br />
          in your AI environment?
        </h2>
        <p>
          Talk through your AI use cases, data flows, and agent permissions with
          Truva.
        </p>
      </div>
      <div class="article-cta-actions">
        <BookingLink label="Discuss an AI security assessment" />
        <a href="/services/ai-security-assessment">
          See the AI assessment scope
        </a>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
<style>
  .ai-article {
    --article-pale: #f3f6fb;
  }
  .article-hero {
    padding-block: 40px 34px;
  }
  .article-hero-grid {
    max-width: 920px;
  }
  .article-back {
    display: inline-block;
    margin-bottom: 24px;
    color: var(--color-brand-blue);
    font-size: 12px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  h1 {
    font-size: clamp(38px, 4vw, 52px);
    line-height: 1.06;
    letter-spacing: -0.04em;
    margin-top: 20px;
    white-space: nowrap;
  }
  h1 span {
    color: var(--color-brand-blue);
  }
  .article-deck {
    font-size: 19px;
    line-height: 1.6;
    color: var(--color-muted);
    margin-top: 26px;
  }
  .guide-value {
    margin-top: 20px;
    color: var(--color-brand-blue);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 11px;
    color: var(--color-muted);
    margin: 25px 0 15px;
  }
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 780px) 300px;
    justify-content: space-between;
    align-items: start;
    gap: 44px;
    padding: 10px 0 70px;
  }
  .article-sidebar {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: 88px;
    align-self: start;
  }
  .article-sidebar nav {
    max-height: calc(100vh - 112px);
    overflow-y: auto;
    padding: 20px 22px;
    background: #fff;
    border: 1px solid var(--color-line);
    border-top: 3px solid var(--color-action);
    border-radius: 10px;
  }
  .article-sidebar .eyebrow {
    margin-bottom: 12px;
    color: var(--color-brand-blue);
  }
  .article-sidebar a {
    display: flex;
    gap: 10px;
    font-size: 11px;
    line-height: 1.25;
    padding: 5px 0;
    color: var(--color-muted);
  }
  .article-sidebar a:hover {
    color: var(--color-brand-blue);
    text-decoration: underline;
  }
  .article-sidebar a span {
    color: var(--color-brand-blue);
    font-size: 9px;
    min-width: 16px;
  }
  .article-body {
    grid-column: 1;
    max-width: 780px;
    min-width: 0;
  }
  .article-lead-visual {
    margin: 0 0 42px;
  }
  .article-lead-visual img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
  }
  .article-lead-visual figcaption {
    margin-top: 10px;
    color: var(--color-muted);
    font-size: 11px;
    line-height: 1.5;
  }
  .article-body h2 {
    font-size: 30px;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }
  .article-body p {
    line-height: 1.75;
    margin-top: 16px;
  }
  .article-intro {
    padding-bottom: 15px;
  }
  .article-intro p:last-child {
    font-size: 14px;
    color: var(--color-muted);
  }
  .guide-metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin: 28px 0 44px;
  }
  .guide-metrics div {
    min-height: 116px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 18px;
    border: 1px solid var(--color-line);
    border-top: 3px solid var(--color-action);
    border-radius: 10px;
    background: #fff;
  }
  .guide-metrics strong {
    color: var(--color-brand-blue);
    font-size: 34px;
    line-height: 1;
  }
  .guide-metrics span {
    margin-top: 9px;
    color: var(--color-muted);
    font-size: 11px;
    line-height: 1.35;
  }
  .decision-table,
  .evidence-map {
    padding: 34px 0 44px;
  }
  .decision-table h2,
  .evidence-map h2 {
    margin-top: 12px;
  }
  .table-scroll {
    overflow-x: auto;
    margin-top: 22px;
    border: 1px solid var(--color-line);
    border-radius: 10px;
  }
  table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    font-size: 13px;
    line-height: 1.5;
  }
  th,
  td {
    padding: 15px 16px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-line);
  }
  th {
    background: var(--color-brand-blue);
    color: #fff;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  tbody tr:last-child td {
    border-bottom: 0;
  }
  tbody tr:nth-child(even) td {
    background: var(--article-pale);
  }
  td:first-child {
    color: var(--color-brand-blue);
    font-weight: 700;
  }
  .article-visual {
    margin: 8px 0 30px;
  }
  .article-visual img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
  }
  .article-visual figcaption {
    margin-top: 10px;
    color: var(--color-muted);
    font-size: 11px;
    line-height: 1.5;
  }
  .risk-detail {
    padding: 45px 0;
    border-bottom: 1px solid var(--color-line);
    scroll-margin-top: 20px;
  }
  .risk-heading {
    display: block;
  }
  .risk-heading h2 {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
  }
  .risk-heading h2 span {
    font: inherit;
    color: inherit;
    letter-spacing: inherit;
  }
  .risk-example {
    background: #fff6ef;
    border-left: 3px solid var(--color-action);
    padding: 19px 22px;
    margin: 24px 0;
  }
  .mini-label {
    font-size: 10px;
    letter-spacing: 0.09em;
    font-weight: 700;
  }
  .risk-example p {
    margin-top: 8px;
    font-size: 15px;
  }
  .article-body h3 {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0;
    margin-top: 24px;
  }
  .article-body ul,
  .article-body ol {
    padding-left: 22px;
    margin: 12px 0;
  }
  .article-body ul {
    list-style: disc;
  }
  .article-body ol {
    list-style: decimal;
  }
  .article-body li {
    padding-left: 5px;
    margin-bottom: 10px;
    line-height: 1.7;
  }
  .risk-evidence {
    background: var(--article-pale);
    padding: 17px 20px;
    font-size: 14px;
  }
  .risk-evidence strong {
    display: block;
    color: var(--color-brand-blue);
    font-size: 12px;
    margin-bottom: 4px;
  }
  .first-week {
    padding: 40px 0;
  }
  .first-week h2 {
    margin-top: 14px;
  }
  .article-sources {
    padding-top: 35px;
    border-top: 1px solid var(--color-line);
    font-size: 13px;
    color: var(--color-muted);
  }
  .article-sources h2 {
    color: var(--color-ink);
    font-size: 24px;
  }
  .article-sources a {
    color: var(--color-brand-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .article-cta {
    background: var(--article-pale);
    border-radius: 12px;
    padding: 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    margin-bottom: 70px;
  }
  .article-cta h2 {
    font-size: 34px;
    margin: 15px 0;
  }
  .article-cta p:not(.eyebrow) {
    max-width: 47ch;
    font-size: 15px;
    color: var(--color-muted);
  }
  .article-cta :global(.button) {
    flex-shrink: 0;
  }
  .article-cta-actions {
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .article-cta-actions a:not(.button) {
    color: var(--color-brand-blue);
    font-size: 13px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 1050px) {
    .article-layout {
      grid-template-columns: minmax(0, 1fr) 260px;
      gap: 28px;
    }
    .article-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 900px) {
    .article-layout {
      display: flex;
      flex-direction: column;
      padding-top: 8px;
    }
    .article-sidebar {
      order: -1;
      width: 100%;
      position: static;
    }
    .article-sidebar nav {
      position: static;
      max-height: none;
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 28px;
    }
    .article-sidebar .eyebrow {
      grid-column: 1 / -1;
    }
    .article-body {
      width: 100%;
      max-width: none;
    }
  }
  @media (max-width: 767px) {
    .article-hero {
      padding-top: 24px;
      padding-bottom: 36px;
    }
    h1 {
      font-size: 40px;
      white-space: normal;
    }
    .article-deck {
      font-size: 17px;
    }
    .guide-metrics {
      grid-template-columns: 1fr 1fr;
    }
    .article-layout {
      padding-bottom: 40px;
    }
    .article-sidebar nav {
      display: block;
    }
    .article-body h2 {
      font-size: 26px;
    }
    .risk-heading {
      display: block;
    }
    .risk-heading h2 {
      font-size: 22px;
      gap: 8px;
    }
    .article-cta {
      padding: 26px;
    }
    .article-cta h2 {
      font-size: 30px;
    }
    .article-cta :global(.button) {
      font-size: 12px;
      max-width: 100%;
    }
    .risk-example {
      padding: 16px;
    }
    .article-body {
      font-size: 15px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      scroll-behavior: auto;
    }
  }
  @media print {
    .article-sidebar,
    .article-cta {
      display: none;
    }
    .article-layout,
    .article-hero-grid {
      display: block;
    }
    .risk-detail {
      break-inside: avoid;
    }
    .article-hero {
      padding-block: 20px;
    }
  }
</style>
