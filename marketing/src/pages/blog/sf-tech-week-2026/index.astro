---
import Base from "../../../layouts/Base.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { weekArticles, hubPath } from "../../../data/sf-tech-week";
import { site } from "../../../data/site";

const title = "SF Tech Week 2026: field notes from the room";
const description = "Thirteen firsthand SF Tech Week recaps on AI, security, founder finance, government sales, community and brand building.";
const lead = weekArticles.find((article) => article.slug === "lessons")!;
const sections = [
  {
    id: "founders",
    label: "01 / BUILDING A BUSINESS",
    title: "Founder decisions",
    description: "Finance, fundraising, buyers, brand and the conversations that shape a company.",
    slugs: [
      "financial-systems-for-founders",
      "preparing-for-series-a",
      "sell-and-scale-with-government",
      "founders-night-meetstream-prefactor",
      "potato-meter-brand-building",
      "built-by-community-reddit",
    ],
  },
  {
    id: "technology",
    label: "02 / BUILDING WITH AI",
    title: "AI, agents and security",
    description: "What builders and security teams are asking about data, identity and reliable delivery.",
    slugs: [
      "sovereign-ai-data-context-control",
      "google-for-startups-wiz",
      "build-ai-agents-with-auth0",
      "agents-and-apis",
      "auth0-buyer-pitch",
      "can-your-agents-actually-ship",
    ],
  },
];
const articleBySlug = new Map(weekArticles.map((article) => [article.slug, article]));
const schema = {
  "@type": "CollectionPage",
  "@id": `${site.url}${hubPath}#collection`,
  name: title,
  description,
  url: `${site.url}${hubPath}`,
  author: { "@type": "Person", name: "Satish" },
  hasPart: weekArticles.map((article) => ({
    "@type": "Article",
    "@id": `${site.url}${hubPath}/${article.slug}#article`,
    headline: article.title,
    url: `${site.url}${hubPath}/${article.slug}`,
  })),
};
---

<Base title="SF Tech Week 2026 | Industry Connector | Truva Solutions" description={description} canonicalPath={hubPath} extraSchema={[schema]}>
  <SiteHeader />
  <main id="main" class="week-hub">
    <div class="shell">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/security-hub">Security Hub</a><span aria-hidden="true"> / </span><span>Industry Connector</span></nav>
      <header class="masthead">
        <div class="masthead-top"><span>INDUSTRY CONNECTOR</span><span>SF TECH WEEK · 2026</span></div>
        <h1>Field notes from SF Tech Week</h1>
        <p class="deck">The conversations behind the headlines: what founders, builders and security teams are working through.</p>
        <p class="byline">By Satish · Truva Solutions <span aria-hidden="true">·</span> 13 reports</p>
      </header>

      <section class="lead-story" aria-labelledby="lead-title">
        {lead.image && <a class="lead-photo" href={`${hubPath}/${lead.slug}`} aria-label="Read the lead SF Tech Week story"><img src={lead.image.src} width={lead.image.width} height={lead.image.height} alt={lead.image.alt} decoding="async" fetchpriority="high" /></a>}
        <div class="lead-copy">
          <p class="eyebrow">THE WEEK IN ONE STORY</p>
          <h2 id="lead-title"><a href={`${hubPath}/${lead.slug}`}>{lead.title}</a></h2>
          <p>{lead.summary}</p>
          <a class="story-link" href={`${hubPath}/${lead.slug}`}>Read the lead story</a>
        </div>
      </section>

      <div class="issue-index" aria-label="Browse the reports"><span>INSIDE THIS EDITION</span><a href="#founders">Founder decisions</a><a href="#technology">AI, agents and security</a></div>

      {sections.map((section) => (
        <section class="report-section" id={section.id} aria-labelledby={`${section.id}-title`}>
          <header>
            <p class="eyebrow">{section.label}</p>
            <h2 id={`${section.id}-title`}>{section.title}</h2>
            <p>{section.description}</p>
          </header>
          <div class="report-list">
            {section.slugs.map((slug, index) => {
              const article = articleBySlug.get(slug)!;
              return (
                <article class="report">
                  <span class="report-number">{String(index + 1).padStart(2, "0")}</span>
                  <div>
                    <p class="report-meta">{article.category}{article.eventDateLabel && ` · ${article.eventDateLabel}`}</p>
                    <h3><a href={`${hubPath}/${article.slug}`}>{article.shortTitle}</a></h3>
                    <p>{article.summary}</p>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))}

      <footer class="edition-footer"><p>Ideas from the room, with the full context in each report.</p><a href="/security-hub">Back to Security Hub</a></footer>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .week-hub { background: #fff; color: #202832; padding: 20px 0 64px; }
  .week-hub .shell { max-width: 1160px; }
  .breadcrumb { color: #667183; font-size: 12px; margin: 0 0 32px; }
  .breadcrumb a { color: #243a6c; text-decoration: underline; text-underline-offset: 3px; }
  .masthead { border-top: 4px solid #243a6c; border-bottom: 1px solid #cdd5df; padding: 12px 0 20px; }
  .masthead-top { color: #34496e; display: flex; justify-content: space-between; gap: 16px; font-size: 11px; font-weight: 800; letter-spacing: .14em; }
  h1 { font-size: clamp(34px, 4.4vw, 50px); line-height: 1.06; letter-spacing: -.04em; margin: 22px 0 11px; max-width: 19ch; text-wrap: balance; }
  .deck { color: #3f4c5c; font-size: clamp(16px, 1.6vw, 19px); line-height: 1.42; max-width: 64ch; }
  .byline { color: #657185; font-size: 12px; margin: 14px 0 0; }
  .lead-story { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 32px; border-bottom: 1px solid #cdd5df; padding: 22px 0; }
  .lead-photo { display: block; overflow: hidden; background: #edf2fa; }
  .lead-photo img { display: block; width: 100%; height: 250px; object-fit: cover; }
  .lead-copy { display: flex; flex-direction: column; align-items: start; justify-content: center; }
  .eyebrow { color: #526680; font-size: 10px; font-weight: 800; letter-spacing: .14em; margin: 0 0 12px; }
  .lead-copy h2 { font-size: clamp(26px, 3vw, 38px); line-height: 1.12; letter-spacing: -.035em; margin: 0 0 14px; text-wrap: balance; }
  .lead-copy > p:not(.eyebrow) { color: #4d5c6e; font-size: 15px; line-height: 1.6; margin: 0 0 20px; }
  .story-link, .edition-footer a { color: #243a6c; font-size: 13px; font-weight: 800; text-decoration: underline; text-underline-offset: 3px; }
  .issue-index { align-items: center; border-bottom: 1px solid #cdd5df; display: flex; flex-wrap: wrap; gap: 14px 24px; padding: 14px 0; }
  .issue-index span { color: #667183; font-size: 10px; font-weight: 800; letter-spacing: .13em; }
  .issue-index a { color: #243a6c; font-size: 12px; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .report-section { padding-top: 42px; scroll-margin-top: 90px; }
  .report-section > header { border-bottom: 2px solid #243a6c; padding-bottom: 18px; }
  .report-section h2 { font-size: clamp(28px, 3vw, 38px); letter-spacing: -.03em; line-height: 1.1; }
  .report-section > header > p:last-child { color: #5b6878; font-size: 13px; margin-top: 8px; }
  .report-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 32px; }
  .report { align-items: start; border-bottom: 1px solid #e0e5eb; display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 10px; min-height: 138px; padding: 19px 0 17px; }
  .report-number { color: #5b6f8d; font-size: 11px; font-weight: 800; padding-top: 2px; }
  .report-meta { color: #5b6f8d; font-size: 10px; font-weight: 800; letter-spacing: .07em; margin: 0 0 6px; text-transform: uppercase; }
  .report h3 { font-size: 19px; letter-spacing: -.02em; line-height: 1.2; margin: 0 0 7px; }
  .report > div > p:last-child { color: #5a6676; font-size: 12px; line-height: 1.5; margin: 0; }
  .edition-footer { align-items: center; background: #edf2fa; display: flex; justify-content: space-between; gap: 20px; margin-top: 48px; padding: 22px 24px; }
  .edition-footer p { color: #34465f; font-size: 14px; margin: 0; }
  .week-hub a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .week-hub a:focus-visible { outline: 2px solid #243a6c; outline-offset: 3px; }
  @media (max-width: 700px) {
    .breadcrumb { margin-bottom: 22px; }
    .masthead-top { flex-direction: column; font-size: 9px; gap: 4px; }
    h1 { margin-top: 23px; }
    .lead-story { grid-template-columns: 1fr; gap: 20px; padding: 22px 0; }
    .lead-photo img { height: 220px; }
    .report-list { grid-template-columns: 1fr; }
    .report { min-height: 0; }
    .edition-footer { align-items: start; flex-direction: column; }
  }
</style>
