---
import Base from "../../../layouts/Base.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { weekArticles, hubPath, reviewDate } from "../../../data/sf-tech-week";
import { site } from "../../../data/site";
export function getStaticPaths() {
  return weekArticles.map(article => ({params: {slug: article.slug}, props: {article}}));
}
const { article } = Astro.props;
const canonicalPath = `${hubPath}/${article.slug}`;
const schema = {
  "@type": "Article",
  "@id": `${site.url}${canonicalPath}#article`,
  headline: article.title,
  description: article.description,
  author: {"@type": "Person", name: "Satish"},
  publisher: {"@id": `${site.url}/#organization`},
  mainEntityOfPage: `${site.url}${canonicalPath}`,
  isPartOf: {"@id": `${site.url}${hubPath}#collection`},
  dateCreated: reviewDate,
  dateModified: reviewDate,
  inLanguage: "en",
  ...(article.image ? {image: new URL(article.image.src, site.url).href} : {}),
};
---
<Base title={`${article.shortTitle} | Truva Solutions`} description={article.description} canonicalPath={canonicalPath} extraSchema={[schema]}>
  <SiteHeader />
  <main id="main" class="shell week-page">
    <nav aria-label="Breadcrumb"><a href={hubPath}>SF Tech Week 2026</a><span aria-hidden="true"> / </span><span>{article.shortTitle}</span></nav>
    <article aria-labelledby="article-title">
      <header class="article-heading">
        <p class="eyebrow">{article.category}</p>
        <h1 id="article-title">{article.title}</h1>
        <p class="byline">By Satish · Truva Solutions</p>
        <p class="review-date">Prepared for review <time datetime={reviewDate}>11 October 2026</time></p>
        {article.eventDate && <p class="event-date">Event: <time datetime={article.eventDate}>{article.eventDateLabel}</time> · {article.location}{article.session && ` · ${article.session}`}</p>}
        <p class="summary">{article.summary}</p>
      </header>
      {article.image && <figure><img src={article.image.src} width={article.image.width} height={article.image.height} alt={article.image.alt} decoding="async" fetchpriority="high"/><figcaption>{article.image.caption}</figcaption></figure>}
      <div class="article-layout">
        <aside><nav aria-label="Article contents"><p class="eyebrow">IN THIS ARTICLE</p>{article.highlights.map((item,i) => <a href={`#highlight-${i+1}`}>{i+1}. {item.title}</a>)}<a href="#takeaway">My takeaway</a><a href="#questions">Questions from this recap</a></nav></aside>
        <div class="article-body">
          {article.intro.map(paragraph => <p>{paragraph}</p>)}
          <ol class="highlights">{article.highlights.map((item,i) => <li id={`highlight-${i+1}`}><h2>{item.title}</h2><p>{item.body}</p></li>)}</ol>
          <section id="takeaway" class="takeaway"><h2>My takeaway</h2><p>{article.takeaway}</p></section>
          {article.closing.map(paragraph => <p>{paragraph}</p>)}
          <section id="questions" class="questions"><h2>Questions from this recap</h2>{article.questions.map(item => <div><h3>{item.question}</h3><p>{item.answer}</p></div>)}</section>
          <section class="article-links" aria-labelledby="links-title"><h2 id="links-title">Explore further</h2><ul>{article.links.map(link => <li><a href={link.url}>{link.label}</a></li>)}</ul></section>
          <p class="reflection">{article.question}</p>
          <footer class="author-note"><p><strong>Satish · Truva Solutions</strong></p><p>We help startups prepare for compliance and serve as their extended cybersecurity team throughout their growth journey.</p><p>Connect with the <a href="https://startupa2z.org">Startupa2z founder community</a>.</p></footer>
        </div>
      </div>
    </article>
  </main>
  <SiteFooter />
</Base>
<style>
  .week-page {padding-block: 28px 64px;}
  .week-page > nav {font-size: 14px; color: var(--color-muted); overflow-wrap: anywhere;}
  a {text-decoration: underline; text-underline-offset: 3px;}
  .article-heading {max-width: 920px; padding-block: 26px;}
  h1 {font-size: clamp(30px, 3.7vw, 46px); line-height: 1.12; margin: 12px 0 18px; text-wrap: balance;}
  .byline {font-weight: 700;}
  .review-date, .event-date {font-size: 14px; color: var(--color-muted); margin-top: 8px;}
  .summary {font-size: 18px; line-height: 1.55; margin-top: 20px; border-left: 3px solid var(--color-action); padding-left: 18px;}
  .article-layout {display: grid; grid-template-columns: 220px minmax(0,740px); gap: 56px;}
  aside nav {position: sticky; top: 110px;}
  aside a {display: block; padding: 12px 0; font-size: 14px;}
  .article-body {min-width: 0; font-size: 17px; line-height: 1.75;}
  .article-body p {margin: 0 0 22px;}
  .highlights {padding-left: 2rem; list-style: decimal;}
  .highlights li {padding: 26px 0 14px 10px; border-bottom: 1px solid var(--color-line); scroll-margin-top: 110px;}
  .highlights li::marker {font-size: 24px; font-weight: 700; color: var(--color-brand-blue);}
  h2 {font-size: clamp(23px, 2.5vw, 29px); line-height: 1.25; margin-bottom: 16px;}
  h3 {font-size: 20px; line-height: 1.4; margin: 24px 0 12px;}
  .takeaway {background: #fff6ef; border-left: 3px solid var(--color-action); padding: 24px; margin: 32px 0;}
  .takeaway p {margin: 0;}
  .questions, .article-links, .author-note {margin-top: 36px; border-top: 1px solid var(--color-line); padding-top: 28px; scroll-margin-top: 110px;}
  .article-links ul {padding-left: 22px; list-style: disc;}
  .article-links a {display: inline-block; padding-block: 8px;}
  .reflection {margin-top: 28px !important; font-weight: 700;}
  .author-note {font-size: 15px;}
  figure {margin: 0 0 36px; max-width: 1000px;}
  figure img {display: block; width: 100%; max-height: 420px; aspect-ratio: 2 / 1; object-fit: cover; border-radius: 8px;}
  figcaption {font-size: 14px; margin-top: 12px; color: var(--color-muted);}
  @media (max-width: 767px) {
    .article-layout {display: block;}
    aside {margin-bottom: 28px; padding: 20px; background: #edf2fa; border-radius: 8px;}
    aside nav {position: static;}
    .article-heading {padding-block: 28px;}
    .summary {font-size: 18px;}
    .takeaway {padding: 20px;}
  }
</style>
