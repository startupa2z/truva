---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BlogCommunity from "../../components/BlogCommunity.astro";
import TopTenInfographic from "../../components/TopTenInfographic.astro";
import BookingLink from "../../components/BookingLink.astro";
import { series } from "../../data/security-series";
export function getStaticPaths() {
  return series.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}
const { article } = Astro.props;
---

<Base
  title={`${article.shortTitle} | Truva Solutions`}
  description={article.description}
>
  <SiteHeader />
  <main id="main" class="series-page shell">
    <a class="text-link" href="/resources/blogs">
      ← All blogs
    </a>
    <header class="series-hero">
      <div>
        <p class="eyebrow">{article.category} / THE TOP 10 SERIES</p>
        <h1>{article.title}</h1>
        <p class="series-lead">{article.description}</p>
        <p class="series-meta">Truva Solutions · Guide · 19 Sep 2026</p>
        <a class="text-link" href="#guide">
          Read the practical guide ↓
        </a>
      </div>
      <TopTenInfographic slug={article.slug} title={article.shortTitle} />
    </header>
    <div class="series-layout" id="guide">
      <aside>
        <nav aria-label="Article contents">
          <p class="eyebrow">IN THIS GUIDE</p>
          {article.items.map((item, i) => (
            <a href={`#issue-${i + 1}`}>
              {String(i + 1).padStart(2, "0")} / {item.title}
            </a>
          ))}
          <a href="#discussion-title">Discussion</a>
        </nav>
      </aside>
      <article class="series-body">
        <div class="scope-note">
          <h2>Before you start</h2>
          <p>{article.scope}</p>
        </div>
        <p>{article.intro}</p>
        {article.items.map((item, i) => (
          <section id={`issue-${i + 1}`} class="series-risk">
            <div class="series-heading">
              <span>{String(i + 1).padStart(2, "0")}</span>
              <h2>{item.title}</h2>
            </div>
            <p>{item.why}</p>
            <div class="series-action">
              <h3>{item.action}</h3>
              <p>{item.check}</p>
            </div>
            <a class="source-link" href={item.source}>
              Primary source ↗
            </a>
          </section>
        ))}
        <section class="series-next">
          <h2>Turn findings into verified fixes.</h2>
          <p>
            Start with your most exposed or sensitive workflow. Confirm the
            issue, assign an owner, make a controlled change, and keep evidence
            from the retest. These checks are a starting point, not proof of
            complete security or compliance.
          </p>
          <BookingLink label="Discuss a security assessment" />
        </section>
        {article.category === "LLM SECURITY" && (
          <p class="source-note">
            Category names and order attributed to{" "}
            <a href="https://genai.owasp.org/llm-top-10/">
              OWASP Top 10 for LLM Applications (2025)
            </a>
            . OWASP content is available under{" "}
            <a href="https://creativecommons.org/licenses/by-sa/4.0/">
              CC BY-SA 4.0
            </a>
            . This article’s adaptation and infographic are offered under the
            same license; Truva’s trademarks are excluded.
          </p>
        )}
        <BlogCommunity />
      </article>
    </div>
  </main>
  <SiteFooter />
</Base>
<style>
  .series-page {
    padding-block: 40px 70px;
  }
  .series-hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 64px;
    align-items: center;
    margin: 35px 0 65px;
  }
  h1 {
    font-size: clamp(40px, 4.4vw, 64px);
    margin: 20px 0;
  }
  .series-lead {
    font-size: 20px;
    color: var(--color-muted);
  }
  .series-meta {
    font-size: 12px;
    color: var(--color-muted);
    margin: 24px 0;
  }
  .series-layout {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    gap: 65px;
  }
  aside nav {
    position: sticky;
    top: 120px;
  }
  aside a {
    display: block;
    font-size: 12px;
    padding: 8px 0;
    color: var(--color-muted);
  }
  aside a:hover {
    text-decoration: underline;
    color: var(--color-brand-blue);
  }
  .series-body {
    max-width: 740px;
    min-width: 0;
  }
  .series-body p {
    line-height: 1.75;
    margin-top: 16px;
  }
  .series-body h2 {
    font-size: 29px;
  }
  .scope-note {
    background: #f3f6fb;
    padding: 24px;
    border-radius: 8px;
  }
  .scope-note h2 {
    font-size: 23px;
  }
  .scope-note p {
    font-size: 14px;
  }
  .series-risk {
    padding-block: 40px;
    border-bottom: 1px solid var(--color-line);
  }
  .series-heading {
    display: flex;
    gap: 20px;
    align-items: baseline;
  }
  .series-heading > span {
    font-size: 32px;
    color: var(--color-brand-blue);
  }
  .series-action {
    margin-top: 22px;
    background: #fff6ef;
    padding: 22px;
    border-left: 3px solid var(--color-action);
  }
  .series-action h3 {
    font-size: 18px;
    font-weight: 700;
  }
  .source-link {
    display: inline-block;
    text-decoration: underline;
    margin-top: 18px;
    font-size: 12px;
  }
  .series-next {
    padding-top: 40px;
  }
  .series-next :global(.button) {
    margin-top: 22px;
  }
  .source-note {
    font-size: 12px;
    color: var(--color-muted);
  }
  .source-note a {
    text-decoration: underline;
  }
  @media (max-width: 1000px) {
    .series-hero {
      gap: 30px;
    }
    .series-layout {
      grid-template-columns: 180px minmax(0, 1fr);
      gap: 30px;
    }
  }
  @media (max-width: 767px) {
    .series-hero {
      grid-template-columns: 1fr;
      margin-top: 25px;
      gap: 30px;
    }
    .series-layout {
      display: block;
    }
    aside {
      display: none;
    }
    h1 {
      font-size: 42px;
    }
    .series-lead {
      font-size: 18px;
    }
    .series-body h2 {
      font-size: 25px;
    }
    .series-action {
      padding: 18px;
    }
    .series-next :global(.button) {
      font-size: 12px;
      max-width: 100%;
    }
  }
</style>
