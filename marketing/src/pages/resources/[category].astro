---
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { insights } from "../../data/insights";
import { site } from "../../data/site";
export function getStaticPaths() {
  return [
    {
      params: { category: "blogs" },
      props: {
        title: "Blogs",
        description: "Ideas and practical guidance for your security journey.",
      },
    },
    {
      params: { category: "white-papers" },
      props: {
        title: "White papers",
        description:
          "In-depth guidance on AI security, cloud security, and compliance.",
      },
    },
    {
      params: { category: "case-studies" },
      props: {
        title: "Case studies",
        description:
          "Client challenges, practical solutions, and verified outcomes.",
      },
    },
  ];
}
const { title, description } = Astro.props;
const isBlog = Astro.params.category === "blogs";
---

<Base title={`${title} | Truva Solutions`} description={description}>
  <SiteHeader />
  <main
    id="main"
    class:list={["resource-page section shell", { "blog-index": isBlog }]}
  >
    {!isBlog && (
      <a class="text-link" href="/security-hub">
        Security Hub
      </a>
    )}
    <header class="resource-heading">
      <h1>{title}</h1>
      <p class="resource-intro">{description}</p>
    </header>
    {isBlog ? (
      <div class="insights-grid resource-links grid md:grid-cols-3">
        {insights.map((post) => (
          <article class="insight-card">
            <a href={post.local ? post.url : `${site.url}${post.url}`}>
              {post.infographic && (
                <img
                  class="blog-thumbnail"
                  src={`/infographics/${post.infographic}.webp`}
                  alt={`${post.title} infographic`}
                  width="1024"
                  height="1280"
                  loading="lazy"
                />
              )}
              <span class="eyebrow">{post.category}</span>
              <h2>{post.title}</h2>
              <p>{post.description}</p>
              <span class="read-label">Read the article →</span>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="resource-empty">
        <h2>Coming soon.</h2>
        <p>
          {title === "Case studies"
            ? "We’ll share client stories once outcomes and permission to publish are confirmed."
            : "Our white papers will appear here when they’re ready."}
        </p>
      </div>
    )}
  </main>
  <SiteFooter />
</Base>

<style>
  .blog-index {
    padding-block: 40px 80px;
  }
  .blog-index .resource-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .blog-index .resource-intro {
    margin: 0;
    max-width: 42ch;
    font-size: 16px;
    line-height: 1.6;
  }
  .blog-index .resource-links {
    margin-top: 32px;
  }
  .blog-index .insight-card {
    border-top: 0;
  }
  .blog-index .insight-card a {
    padding-top: 0;
  }
  .blog-index .insight-card h2 {
    font-size: 26px;
    line-height: 1.2;
    margin-top: 10px;
  }
  @media (max-width: 767px) {
    .blog-index {
      padding-top: 28px;
    }
    .blog-index .resource-heading {
      display: block;
    }
    .blog-index .resource-intro {
      margin-top: 12px;
    }
    .blog-index .resource-links {
      margin-top: 28px;
    }
  }

  .blog-thumbnail {
    width: 100%;
    height: 260px;
    object-fit: cover;
    object-position: top;
    border-radius: 6px;
    margin-bottom: 24px;
  }
</style>
