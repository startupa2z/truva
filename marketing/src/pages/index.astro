---
import CompanySections from "../components/CompanySections.astro";
import Base from "../layouts/Base.astro";
import BookingLink from "../components/BookingLink.astro";
import Arrow from "../components/Arrow.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SecurityIllustration from "../components/SecurityIllustration.astro";
import { site } from "../data/site";
import clients from "../data/clients.json";
import { insights } from "../data/insights";
const steps = [
  {
    name: "Assess",
    text: "Start with your technology, processes, customers, and the risks that matter. Agree on a clear scope.",
  },
  {
    name: "Remediate",
    text: "Work through a prioritized plan. Put practical controls in place with your team.",
  },
  {
    name: "Prepare for audit",
    text: "Organize evidence and support independent auditors or certification bodies when needed.",
  },
  {
    name: "Sustain",
    text: "Keep ownership clear. Review changes and maintain the practices as your business grows.",
  },
];
---

<Base
  title="Startup Security & Compliance Consulting | Truva Solutions"
  description="AI security, cloud security, and SOC 2 and ISO readiness for startups. Senior-led, practical support. Book a free 30-minute security consult."
>
  <SiteHeader />
  <main id="main">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="tiny-line"></span> AI SECURITY · CLOUD SECURITY ·
          COMPLIANCE
        </p>
        <h1 id="hero-title">
          Protect your business.
          <br />
          <span>Win customer trust.</span>
        </h1>
        <p class="hero-description">
          We find and fix risks across your AI, cloud, and business
          processes—and help you prepare for SOC&nbsp;2 and ISO audits.
        </p>
        <BookingLink label="Let’s talk about your security" />
        <p class="hero-note">Start with a free 30-minute conversation.</p>
      </div>
      <div class="hero-art">
        <SecurityIllustration />
      </div>
    </section>
    <section class="logo-preview section-border" aria-label="Tools and frameworks">
      <div class="shell">
          <div class="logo-preview-heading"><span class="eyebrow">TOOLS &amp; FRAMEWORKS</span><span>Independent technology and standards coverage</span></div>
          <div class="logo-preview-grid">
            <div class="tool-logo"><img src="/images/tools/wiz.svg" alt="Wiz" width="90" height="42" /><span>Cloud security</span></div>
            <div class="tool-logo"><img src="/images/tools/prowler.png" alt="Prowler" width="132" height="42" /><span>Cloud assessment</span></div>
            <div class="tool-logo"><img src="/images/tools/orca.svg" alt="Orca Security" width="140" height="42" /><span>Cloud security</span></div>
            <div class="framework-mark"><strong>SOC 2</strong><span>Trust services</span></div>
            <div class="framework-mark"><strong>ISO 27001</strong><span>Information security</span></div>
            <div class="framework-mark"><strong>ISO 42001</strong><span>AI management</span></div>
          </div>
      </div>
    </section>
    <CompanySections />
    <section
      id="approach"
      class="section shell section-border"
      aria-labelledby="approach-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 / HOW WE WORK</p>
          <h2 id="approach-title">
            Clear steps.
            <br />
            Lasting progress.
          </h2>
        </div>
        <p>
          You work directly with senior practitioners, bringing{" "}
          {site.experience.toLowerCase()} to your technology and processes. We
          make the priorities clear and help your team put them into practice.
        </p>
      </div>
      <ol class="steps-grid grid md:grid-cols-4">
        {steps.map((step, i) => (
          <li>
            <span class="step-number">0{i + 1}</span>
            <h3>{step.name}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
      <p class="section-footnote">
        Truva supports readiness and audit preparation. Independent auditors
        issue SOC 2 reports; certification bodies issue ISO certifications.
      </p>
    </section>
    {site.preview && (
    <section
      id="proof"
      class="section shell section-border"
      aria-labelledby="proof-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / THE WORK SHOULD SPEAK</p>
          <h2 id="proof-title">Proof, with context.</h2>
        </div>
        <p>
          Client outcomes and stories will appear here once the results and
          permission to share them are confirmed.
        </p>
      </div>
      <div class="proof-grid grid md:grid-cols-3">
        {clients.todo.metrics.map((item, i) => (
          <div class="proof-card">
            <span class="proof-index">0{i + 1} / TO BE VERIFIED</span>
            <p>{item}</p>
          </div>
        ))}
      </div>
      <div class="testimonial-placeholder">
        <span class="eyebrow">CLIENT PERSPECTIVE</span>
        <p class="placeholder-note">{clients.todo.testimonials}</p>
      </div>
    </section>
    )}
    <section
      id="insights"
      class="section shell section-border"
      aria-labelledby="insights-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">03 / INSIGHTS</p>
          <h2 id="insights-title">
            A little clarity
            <br />
            goes a long way.
          </h2>
        </div>
        <a class="text-link" href="/security-hub">
          Explore the Security Hub
          <Arrow />
        </a>
      </div>
      <div class="insights-grid grid md:grid-cols-3">
        {insights.map((post) => (
          <article class="insight-card">
            <a href={post.local ? post.url : `${site.url}${post.url}`}>
              <div class="insight-top">
                <span class="eyebrow">{post.category}</span>
                <Arrow diagonal />
              </div>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
              <span class="read-label">Read the article</span>
            </a>
          </article>
        ))}
      </div>
    </section>
    <section class="closing-cta" aria-labelledby="closing-title">
      <div class="shell closing-inner">
        <div>
          <p class="eyebrow">YOUR NEXT STEP</p>
          <h2 id="closing-title">
            Let’s make security
            <br />a reason you move forward.
          </h2>
          <p>Tell us what you’re building. We’ll start there.</p>
        </div>
        <BookingLink label="Book a free 30-minute consult" light />
      </div>
    </section>
    <section
      id="consult"
      class="consult-section shell"
      aria-labelledby="consult-title"
    >
      <div>
        <p class="eyebrow">LET’S TALK</p>
        <h2 id="consult-title">A conversation, not a commitment.</h2>
        <p>
          Share what you’re building and the security question in front of you.
          Choose a time for a free 30-minute call.
        </p>
      </div>
      <div class="consult-action">
        <BookingLink label="Choose a consultation time" />
        <a
          class="text-link"
          href={`mailto:${site.email}?subject=${encodeURIComponent("Free 30-minute security consult")}`}
        >
          {site.email}
          <Arrow diagonal />
        </a>
        <p class="booking-note">
          30 minutes · Google Meet · Select a time on Calendly
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .hero h1 { font-size: clamp(32px, 3.5vw, 44px); line-height: 1.2; letter-spacing: -.035em; }
  .hero .eyebrow { margin-bottom: 32px; }
  .hero-description { margin-top: 32px; max-width: 46ch; }
  .hero { column-gap: 40px; }
  @media (max-width: 767px) {
    .hero h1 { font-size: 32px; }
    .hero .eyebrow { margin-bottom: 24px; }
    .hero-description { margin-top: 24px; }
  }
</style>

<style>
.logo-preview { padding-block: 24px 28px; }
.logo-preview-heading { display:flex; justify-content:space-between; gap:16px; align-items:center; }
.logo-preview-heading > span:last-child { font-size:11px; color:var(--color-muted); }
.logo-preview-grid { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:16px; align-items:center; margin-top:24px; }
.tool-logo, .framework-mark { display:grid; grid-template-rows:40px 16px; gap:6px; justify-items:center; align-items:center; min-width:0; text-align:center; color:var(--color-brand-blue); }
.tool-logo img { display:block; object-fit:contain; filter:brightness(0) saturate(100%); max-width:100%; }
.tool-logo img[alt="Wiz"] { width:64px; height:29px; }
.tool-logo img[alt="Prowler"] { width:124px; height:34px; }
.tool-logo img[alt="Orca Security"] { width:84px; height:32px; }
.framework-mark strong { font-size:20px; line-height:1; letter-spacing:-.04em; white-space:nowrap; }
.tool-logo span, .framework-mark span { display:block; font-size:10px; line-height:16px; color:var(--color-muted); margin:0; white-space:nowrap; }
@media(max-width:767px) { .logo-preview-grid { grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px 12px; } .logo-preview-heading { display:block; } .logo-preview-heading > span:last-child { display:block; margin-top:6px; } .framework-mark strong { font-size:17px; } }
</style>
