{
  "name": "truva-marketing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 4321",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "node server/community.mjs",
    "verify": "node scripts/verify.mjs",
    "build:release": "node scripts/release-guard.mjs && ASTRO_TELEMETRY_DISABLED=1 DEPLOY_ENV=production astro build && node scripts/prepare-release.mjs",
    "assets": "node scripts/assets.mjs",
    "format": "prettier --plugin=prettier-plugin-astro --write \"src/**/*.{astro,css,ts,json}\" \"scripts/*.mjs\"",
    "preview:static": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 4321",
    "test:community": "node --test server/community.test.mjs",
    "refresh:security": "node scripts/security-feed.mjs",
    "test:security": "node --test scripts/security-feed*.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "sharp": "0.35.4",
    "typescript": "6.0.3"
  }
}
